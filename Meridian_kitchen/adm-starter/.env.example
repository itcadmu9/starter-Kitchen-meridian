# Copy to .env before running `docker compose up`.

# --- PostgreSQL ---
POSTGRES_USER=meridian
POSTGRES_PASSWORD=meridian
POSTGRES_DB=meridian
POSTGRES_PORT=5432

# --- MongoDB ---
MONGO_PORT=27017
MONGO_DB_NAME=meridian

# --- Backend (FastAPI) ---
# Inside docker-compose, hosts are the service names (postgres, mongo). If you run
# the backend outside Docker against the compose databases, swap in "localhost".
DATABASE_URL=postgresql+psycopg2://meridian:meridian@postgres:5432/meridian
MONGO_URL=mongodb://mongo:27017
BACKEND_PORT=8000
SEED_ON_STARTUP=true
DEFAULT_PROPERTY_CAPACITY=20
CORS_ORIGINS=["http://localhost:5173"]
